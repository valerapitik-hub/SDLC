digraph G { graph [fontname="DejaVu Sans", fontsize=14, pad=0.3, bgcolor="white"]; node [fontname="DejaVu Sans", fontsize=11, shape=plain]; edge [fontname="DejaVu Sans", fontsize=10, color="#A80036"];
rankdir=LR; nodesep=0.45; ranksep=1.0; 
home [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>HomePage</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>parts</I></FONT><BR ALIGN="LEFT"/>filters : FilterPanel<BR ALIGN="LEFT"/>cards : EventCard[*]<BR ALIGN="LEFT"/>pagination : Pagination<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>sortBy : String = "date"<BR ALIGN="LEFT"/>dateFrom, dateTo : String<BR ALIGN="LEFT"/>genre : String<BR ALIGN="LEFT"/>priceMin, priceMax : Real<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>book(event)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-001, REQ-INT-001<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>EventPage</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>parts</I></FONT><BR ALIGN="LEFT"/>seatMap : SeatMap<BR ALIGN="LEFT"/>cart : CartPanel<BR ALIGN="LEFT"/>timer : ReservationTimer<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>title, dateTime, venue : String<BR ALIGN="LEFT"/>legend : Free | Reserved | Sold<BR ALIGN="LEFT"/>subtotal, total : Real (BYN)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>selectSeat<BR ALIGN="LEFT"/>removeSeat<BR ALIGN="LEFT"/>checkout<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-002…005, REQ-INT-002<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
conf [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>ConfirmationPage</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>parts</I></FONT><BR ALIGN="LEFT"/>ticketCard : TicketCard<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>orderId : String<BR ALIGN="LEFT"/>email : String<BR ALIGN="LEFT"/>qrImage : Image<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>downloadPdf  (0.2)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-006…008, REQ-INT-003<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
my [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>MyTicketsPage</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>orderId : String<BR ALIGN="LEFT"/>email : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>find<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-009, REQ-INT-005<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
login [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>AdminLoginPage</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>login : String<BR ALIGN="LEFT"/>password : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>signIn<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-011<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
admin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>AdminPanel</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>parts</I></FONT><BR ALIGN="LEFT"/>kpiCards : KpiCard[4]<BR ALIGN="LEFT"/>eventsTable : EventsTable<BR ALIGN="LEFT"/>searchBar, statusFilter<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>totalEvents, activeEvents : Integer<BR ALIGN="LEFT"/>totalRevenueByn : Real<BR ALIGN="LEFT"/>ticketsSold : Integer<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>createEvent<BR ALIGN="LEFT"/>editEvent<BR ALIGN="LEFT"/>deleteEvent<BR ALIGN="LEFT"/>cancelReservation<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-012…014, REQ-INT-004<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
verify [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«part def»</I></FONT><BR/><B>VerifyPage</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>attributes</I></FONT><BR ALIGN="LEFT"/>scanResult : VerifyResult<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>actions</I></FONT><BR ALIGN="LEFT"/>scan<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FEFECE"><FONT POINT-SIZE="9" COLOR="#555555"><I>satisfies</I></FONT><BR ALIGN="LEFT"/>REQ-FUNC-010, REQ-INT-006<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
home -> event [arrowhead=vee, fontsize=10, label="book"];
event -> conf [arrowhead=vee, fontsize=10, label="checkout\n(email + оплата)"];
conf -> home [arrowhead=vee, fontsize=10, style=dashed, label="на главную"];
home -> my [arrowhead=vee, fontsize=10, style=dashed, label="My Tickets"];
my -> conf [arrowhead=vee, fontsize=10, style=dashed, label="билеты найдены"];
login -> admin [arrowhead=vee, fontsize=10, label="signIn\n[роль: администратор]"];
login -> verify [arrowhead=vee, fontsize=10, label="signIn\n[роль: контролёр]"];
}