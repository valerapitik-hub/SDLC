digraph G { graph [fontname="DejaVu Sans", fontsize=14, pad=0.3, bgcolor="white"]; node [fontname="DejaVu Sans", fontsize=11, shape=plain]; edge [fontname="DejaVu Sans", fontsize=10, color="#A80036"];
rankdir=LR; nodesep=0.3; ranksep=1.3; 
buyer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«actor»</I></FONT><BR/><B>Покупатель</B></TD></TR></TABLE>>];
ctl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«actor»</I></FONT><BR/><B>Контролёр</B></TD></TR></TABLE>>];
adm [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A80036"><TR><TD ALIGN="CENTER" BGCOLOR="#FEFECE"><FONT POINT-SIZE="10"><I>«actor»</I></FONT><BR/><B>Администратор</B></TD></TR></TABLE>>];
subgraph cluster_s { label=<<I>«subject»</I> <B>EasyTicketSystem</B>>; style="rounded"; color="#A80036"; fontsize=12;
u1 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Просмотреть каталог\n(REQ-FUNC-001, 002)"];
u2 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Выбрать места\nи забронировать\n(REQ-FUNC-003…005)"];
u3 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Оформить заказ\n(REQ-FUNC-006)"];
u4 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Получить билет\nс QR-кодом\n(REQ-FUNC-007, 008)"];
u5 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Найти билеты\nпо заказу\n(REQ-FUNC-009)"];
u6 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Проверить билет\nна входе\n(REQ-FUNC-010)"];
u7 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Войти в систему\n(REQ-FUNC-011)"];
u8 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Управлять\nмероприятиями\n(REQ-FUNC-012)"];
u9 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Смотреть статистику\n(REQ-FUNC-013)"];
u10 [shape=ellipse, style=filled, fillcolor="#FEFECE", color="#A80036", label="Отменить бронь\n(REQ-FUNC-014)"];
}
buyer -> u1 [arrowhead=none];
buyer -> u2 [arrowhead=none];
buyer -> u3 [arrowhead=none];
buyer -> u4 [arrowhead=none];
buyer -> u5 [arrowhead=none];
ctl -> u6 [arrowhead=none];
adm -> u7 [arrowhead=none];
adm -> u8 [arrowhead=none];
adm -> u9 [arrowhead=none];
adm -> u10 [arrowhead=none];
ctl -> u7 [arrowhead=none];
u3 -> u4 [style=dashed, arrowhead=vee, label="«include»", fontsize=9]; u3 -> u2 [style=dashed, arrowhead=vee, label="«include»", fontsize=9];
u6 -> u7 [style=dashed, arrowhead=vee, label="«include»", fontsize=9];
u8 -> u7 [style=dashed, arrowhead=vee, label="«include»", fontsize=9];
u9 -> u7 [style=dashed, arrowhead=vee, label="«include»", fontsize=9];
u10 -> u7 [style=dashed, arrowhead=vee, label="«include»", fontsize=9];
}